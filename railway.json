{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && source $HOME/.local/bin/env && uv sync"
  },
  "deploy": {
    "region": "us-west2",
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "uv run uvicorn server.app:app --host 0.0.0.0 --port $PORT",
    "sleepApplication": false,
    "multiRegionConfig": {
      "us-west2": {
        "numReplicas": 1
      }
    },
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
